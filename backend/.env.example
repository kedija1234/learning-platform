# Server configuration
PORT=5000

# Database configuration (works with local MySQL and TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=learning_platform
# Set DB_SSL to true when connecting to TiDB Cloud or any SSL-enabled database
DB_SSL=false

# Authentication
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# CORS configuration (comma-separated list of allowed frontend origins; localhost:5173 and localhost:5174 allowed in development)
FRONTEND_URL=https://your-frontend-app.vercel.app
